# ──────────────────────────────────────────────────────────
# Production environment template
# Copy to .env at the repo root and fill in the secrets.
# ──────────────────────────────────────────────────────────

# MySQL — use a strong, unique password
MYSQL_DATABASE=charity
MYSQL_USER=charity_user
MYSQL_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT

# JWT — required. The app refuses to start without it, and rejects anything
# shorter than 32 bytes. Generate with: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_EXPIRATION_MS=86400000

# The first admin account. No admin is seeded if this is unset, which leaves a
# fresh production database with no way to log in.
ADMIN_INITIAL_PASSWORD=CHANGE_ME

# APP_SITE_URL is the public site; APP_BASE_URL is the API. They are deliberately
# separate — when they were one value pointing at the API, every "view on site"
# link posted to the messaging channels resolved to the backend port.
APP_SITE_URL=https://your-domain.com
APP_BASE_URL=https://api.your-domain.com
CORS_ORIGINS=https://your-domain.com

# Messaging — off by default; a bad token makes every publish log an error.
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHANNEL=@your_channel
TELEGRAM_ENABLED=false
BALE_BOT_TOKEN=YOUR_BALE_BOT_TOKEN
BALE_CHANNEL=@your_bale_channel
BALE_ENABLED=false

# Flyway baselines a pre-existing (pre-Flyway) database on first run: V1 is skipped
# and V2 onward applied. Safe to leave on; set false once the database is managed.
FLYWAY_BASELINE_ON_MIGRATE=true

# Swagger is off unless explicitly enabled.
SPRINGDOC_ENABLED=false
