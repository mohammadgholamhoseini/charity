# SSR needs a Node runtime, so this replaces the previous static nginx image.
#
# Dockerfile.dev and Dockerfile.master are intentionally identical: everything that
# used to differ between them lived in the two nginx configs (which backend to proxy
# to), and that is now an environment variable. Both files still have to exist because
# docker-build.sh selects one by tag.

FROM node:22-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
ENV NODE_ENV=production
RUN npm run build

FROM node:22-alpine AS runtime
WORKDIR /app

# tzdata so Intl can resolve Asia/Tehran; without it the server renders Jalali dates
# against UTC and disagrees with the browser by three and a half hours.
RUN apk add --no-cache tzdata wget \
    && addgroup -S nuxt && adduser -S nuxt -G nuxt

ENV NODE_ENV=production \
    NITRO_PORT=3000 \
    NITRO_HOST=0.0.0.0 \
    TZ=Asia/Tehran

# Nitro bundles its dependencies into .output, so no node_modules ships here.
COPY --from=build --chown=nuxt:nuxt /app/.output ./.output

USER nuxt
EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=3s --start-period=15s --retries=3 \
  CMD wget -qO- http://127.0.0.1:3000/healthz || exit 1

CMD ["node", ".output/server/index.mjs"]
